# Used by docker compose (the server itself does not read .env files; export these in your shell instead).
OPENCOACH_DEMO=0
PUBLIC_URL=http://localhost:8080
VIEWS_URL=http://localhost:8081
# Chat models (all tiers). Or OPENCOACH_CONFIG with explicit tiers for other endpoints.
OPENROUTER_API_KEY=
# Voice only (speech-to-text, text-to-speech, calls).
OPENAI_API_KEY=
# Optional services
# Requires imageGeneration YAML configuration with a separate image-provider key.
OPENCOACH_IMAGE_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
TELEGRAM_BOT_TOKEN=
OPENCOACH_ADMIN_TOKEN=
# Outside Docker: OPENCOACH_DATA_DIR, PORT, VIEWS_PORT, OPENCOACH_SANDBOX, OPENCOACH_CHROMIUM_PATH
