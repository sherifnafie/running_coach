{
  "name": "opencoach",
  "private": true,
  "version": "0.1.0",
  "description": "OpenCoach: an open-source, AI-native running coach harness",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @opencoach/web --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @opencoach/server dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @opencoach/server start"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
